# Copy to .env and fill in only what you use. .env is git-ignored.
# None of this is needed for the default offline mode.

# --llm / --provider claude
ANTHROPIC_API_KEY=

# --provider openai (api.openai.com)
OPENAI_API_KEY=

# Any other OpenAI-compatible server (OpenRouter, Gemini, a hosted vLLM, ...).
# Takes precedence over OPENAI_API_KEY. Local Ollama / LM Studio need no key.
CATCHRATE_API_KEY=
